# Any Postgres — local, Railway, Neon. The local app and the public unsubscribe
# deployment share this one database.
#   local:   postgresql://you@localhost:5432/qatalyst
#   hosted:  postgresql://user:password@host:5432/db?sslmode=require
DATABASE_URL=postgresql://you@localhost:5432/qatalyst

# Single shared login for the local app.
APP_PASSWORD=change-me

# Signs unsubscribe tokens. Same value in both deployments or links stop verifying.
# openssl rand -base64 32
UNSUBSCRIBE_SECRET=

# Public origin of the unsubscribe deployment. Never localhost — this ends up in
# every email we send.
UNSUBSCRIBE_BASE_URL=https://unsubscribe.example.com

# Set to 1 on the public deployment ONLY. Serves /u/* and 404s everything else,
# so the contact list is never exposed to the internet.
# PUBLIC_ONLY=1

# Optional, used by the seed script for the example mailbox addresses.
# SEND_DOMAIN=qalakaar.com

# Personalisation (phase 2). Either export ANTHROPIC_API_KEY, or run `ant auth
# login` once — the SDK picks up the stored profile with no env var at all.
# ANTHROPIC_API_KEY=

# Sending (phase 3). One Google Workspace service account with domain-wide
# delegation, scoped to https://www.googleapis.com/auth/gmail.send, impersonates
# every mailbox. Paste the whole downloaded JSON on one line.
# Leave it unset and sending runs as a dry run: it records exactly what it would
# have sent, including a placeholder Message-ID, and never contacts Google.
# GOOGLE_SERVICE_ACCOUNT_JSON={"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\n..."}

# Sending from several domains. Google's domain-wide delegation is per
# Workspace, so a domain in its own Workspace needs its own service account.
# One variable per domain, named after it — the Sending screen tells you the
# exact name it is looking for and whether it found it.
#   qalakaar.com  →  GOOGLE_SA_QALAKAAR_COM
#   qalakaarhq.com → GOOGLE_SA_QALAKAARHQ_COM
# A domain with no key of its own falls back to GOOGLE_SERVICE_ACCOUNT_JSON,
# so an installation that never split its sending is unaffected.
# GOOGLE_SA_QALAKAAR_COM={"client_email":"...","private_key":"..."}

# ── Sources ──────────────────────────────────────────────────────────────────
# Apollo. Enrichment works on the free plan; People Search needs a paid one and
# the connector says so rather than returning an empty result.
APOLLO_API_KEY=

# The bearer secret for POST /api/ingest/:preset — how a LinkedIn exporter
# (Evaboot, PhantomBuster, Clay) pushes rows in. Unset means the door is shut.
INGEST_SECRET=

# Which of your sites may report conversions to /api/collect. Comma-separated
# origins, scheme included.
#
# This is an allowlist, NOT a secret — it is checked against the browser's own
# Origin header, which page script cannot forge, and it is safe to commit.
# Unset allows nobody, so a missed deployment step fails closed rather than
# leaving an open endpoint that writes to the conversions table.
SITE_ORIGINS=https://qalakaar.com,https://app.qalakaar.com
