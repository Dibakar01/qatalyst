# Any Postgres — local, Railway, Neon. The local app and the public unsubscribe
# deployment share this one database.
#   local:   postgresql://you@localhost:5432/qatalyst
#   hosted:  postgresql://user:password@host:5432/db?sslmode=require
DATABASE_URL=postgresql://you@localhost:5432/qatalyst

# Single shared login for the local app.
APP_PASSWORD=change-me

# Signs unsubscribe tokens. Same value in both deployments or links stop verifying.
# openssl rand -base64 32
UNSUBSCRIBE_SECRET=

# Public origin of the unsubscribe deployment. Never localhost — this ends up in
# every email we send.
UNSUBSCRIBE_BASE_URL=https://unsubscribe.example.com

# Set to 1 on the public deployment ONLY. Serves /u/* and 404s everything else,
# so the contact list is never exposed to the internet.
# PUBLIC_ONLY=1

# Optional, used by the seed script for the example mailbox addresses.
# SEND_DOMAIN=qalakaar.com
