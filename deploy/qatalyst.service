# systemd unit for the private/sending box — installs alongside docker-compose.yml.
#
# What this is for, and what it is NOT for:
#   `restart: always` in docker-compose.yml is the worker's actual supervision —
#   it is what brings `npm run send` back if the process itself crashes or
#   exits. That policy only applies to a container Docker already knows
#   about. If the HOST reboots, the Docker daemon starts with no containers
#   running at all — nothing brings `docker compose up -d` back on its own.
#   This unit is that missing step: it runs once at boot, starts the compose
#   stack (reacher + worker), and lets Docker's own restart policy take over
#   from there. It is host-boot glue, not a process supervisor — Docker
#   remains the only thing restarting a crashed worker while the box is up.
#
# Install:
#   sudo cp deploy/qatalyst.service /etc/systemd/system/qatalyst.service
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now qatalyst
#
# Check:
#   systemctl status qatalyst
#   docker compose -f /opt/qatalyst/docker-compose.yml ps

[Unit]
Description=Qatalyst (reacher + send worker) via docker compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Adjust WorkingDirectory to wherever this repo is deployed on the box.
WorkingDirectory=/opt/qatalyst
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
