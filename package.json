{
  "name": "qatalyst",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test lib/*.test.ts",
    "test:acceptance": "node --env-file-if-exists=.env scripts/acceptance.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:reset": "node --env-file-if-exists=.env scripts/reset.ts",
    "token": "node --env-file-if-exists=.env scripts/token.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "next": "16.3.0",
    "papaparse": "^5.5.4",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
